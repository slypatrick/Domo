# Security headers for static files (the app page itself). Framing stays allowed on / because sellers embed
# their shop with /?shop=<slug>&embed=1; worker routes add frame-ancestors 'none' themselves.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self)
